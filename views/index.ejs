<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members-Only Bulletin Board</title>
</head>
<body>
    <h1>Members-Only Bulletin Board</h1>
<% if (locals.currentUser) { %>
    <p>Welcome、<%= currentUser.first_name %> ！</p>
    <% if (!currentUser.membership_status) { %>
        <a href="/join-club"><button>Become a club member（Please enter a secret code）</button></a>
    <% } else { %>
        <p style="color: green; font-weight: bold;">★ You are a club member (the poster will be displayed)</p>
    <% } %>
    <a href="/log-out">Log out</a>
<% } else { %>
    <a href="/log-in">Log in</a> | <a href="/sign-up">Sign up</a>
<% } %>

<h2>Message List</h2>
<ul>
    <% messages.forEach(message => { %>
        <li>
            <h3><%= message.title %></h3>
            <p><%= message.text %></p>

            <% if(locals.currentUser && (currentUser.membership_status || currentUser.is_admin)) { %>
                <small>Poster: <%= message.first_name %> <%= message.last_name %> (<%= message.username %>) / Date posted: <%= message.timestamp %></small>
            <% } else {%>
                <small>Posted by: Secret (visible to club members)</small>
            <% } %>

            <% if (locals.currentUser && currentUser.is_admin) { %>
                <form action="/messages/<%= message.id %>/delete" method="post" style="display: inline;">
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this message?')" style="color: red;">Delete</button>
                </form>
            <% } %>
        </li>
    <% }) %>
</ul>

<hr>
</body>
</html>